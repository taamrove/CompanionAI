# ── Inference routing ───────────────────────────────────────────────
# hybrid     : local Ollama for light dialogue, cloud Claude for heavy lifting
# local_only : everything runs on Ollama (fully offline)
# cloud_only : everything runs on Claude
LLM_MODE=hybrid

# ── Cloud (Claude) — the "heavy lifting" brain ──────────────────────
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-opus-4-8
# Effort for cloud reasoning: low | medium | high | max
CLOUD_EFFORT=high

# ── Local (Ollama) — light, fast, offline dialogue ──────────────────
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# ── Memory / storage ────────────────────────────────────────────────
DATA_DIR=/data
# How many retrieved memories to inject into context
RAG_TOP_K=5

# ── Self-improvement (userland skills) ──────────────────────────────
# Master kill switch. When false, the AI cannot change any skill. The running
# system cannot flip this — only you can (it lives in the kernel config).
SELFIMPROVE_ENABLED=false
# auto = stage revisions to apply on restart (health-gated, auto-rollback)
# propose = only queue revisions for human approval
SELFIMPROVE_MODE=auto
# Seconds of crash-free uptime before the brain self-confirms an applied
# revision as last-known-good. Set 0 to let the watchdog own confirm/rollback.
SELF_CONFIRM_SECONDS=20

# ── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# Optional shared secret. If set, API calls must send
#   Authorization: Bearer <API_TOKEN>
# Leave empty for open access on a trusted/private network (e.g. Tailscale).
API_TOKEN=

