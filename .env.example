# ── Inference routing ───────────────────────────────────────────────
# hybrid     : local Ollama for light dialogue, cloud Claude for heavy lifting
# local_only : everything runs on Ollama (fully offline)
# cloud_only : everything runs on Claude
LLM_MODE=hybrid

# ── Cloud (Claude) — the "heavy lifting" brain ──────────────────────
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-opus-4-8
# Effort for cloud reasoning: low | medium | high | max
CLOUD_EFFORT=high

# ── Local (Ollama) — light, fast, offline dialogue ──────────────────
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# ── Memory / storage ────────────────────────────────────────────────
DATA_DIR=/data
# How many retrieved memories to inject into context
RAG_TOP_K=5

# ── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
